# Copy to `airflow/.env` and fill in. `.env` is gitignored; this file is not.
# Nothing here should ever hold a real value.
#
#   cp .env.example .env
#   docker compose build && docker compose up -d     # UI: http://localhost:8080

# --- Snowflake -------------------------------------------------------------
# Account identifier, e.g. ab12345.ap-south-1 — not the full URL.
SNOWFLAKE_ACCOUNT=ab12345.ap-south-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=

# --- Gemini ----------------------------------------------------------------
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Airflow ---------------------------------------------------------------
# Rows the sample task pulls when smoke-testing a DAG.
SAMPLE_N=5
