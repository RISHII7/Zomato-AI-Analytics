# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
# Nothing here should ever hold a real value.

# --- AWS -------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=000000000000
# The lake. One bucket, seven prefixes under raw/.
S3_BUCKET=zomato-dl-yourname
S3_RAW_PREFIX=raw/
# Prefer an SSO profile or an instance role over static keys.
AWS_PROFILE=default

# --- Snowflake -------------------------------------------------------------
# Account identifier, e.g. ab12345.ap-south-1 — not the full URL.
SNOWFLAKE_ACCOUNT=ab12345.ap-south-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_ROLE=DBT_ROLE
SNOWFLAKE_WAREHOUSE=ZOMATO_WH
SNOWFLAKE_DATABASE=ZOMATO
SNOWFLAKE_SCHEMA=STAGING

# Key-pair auth is preferred over a password: it is what Airflow and dbt
# should use, and it cannot be phished. Point this at a `chmod 600` file
# outside the repo. Never inline the key itself.
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- OpenAI ----------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Guard rail for the enrichment job: stop after this many rows per run so a
# loop bug cannot quietly spend a month's budget overnight.
OPENAI_MAX_ROWS_PER_RUN=2000

# --- Airflow ---------------------------------------------------------------
AIRFLOW_HOME=./airflow
AIRFLOW__CORE__LOAD_EXAMPLES=False

# --- App -------------------------------------------------------------------
# Text-to-SQL runs generated SQL as DBT_ROLE behind a SELECT-only guard.
# Keep this false unless you are actively debugging the generator.
ALLOW_NON_SELECT_SQL=false
STREAMLIT_SERVER_PORT=8501
